#!/bin/sh

set -eu

terminal_workspace='>'
current_workspace=$(swaymsg -t get_workspaces -r |
    jq -r '.[] | select(.focused) | .name')

if [ "$current_workspace" = "$terminal_workspace" ]; then
    swaymsg 'workspace back_and_forth' >/dev/null
    exit
fi

if swaymsg -t get_tree -r | jq -e --arg workspace "$terminal_workspace" '
    first(
        .. | objects |
        select(.type? == "workspace" and .name? == $workspace) |
        .. | objects |
        select(
            ((.app_id // "") | ascii_downcase | contains("ghostty")) or
            ((.window_properties.class // "") | ascii_downcase | contains("ghostty"))
        )
    ) // false
' >/dev/null; then
    swaymsg "workspace \"$terminal_workspace\"" >/dev/null
else
    swaymsg "workspace \"$terminal_workspace\"; exec ghostty" >/dev/null
fi

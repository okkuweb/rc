[Desktop Entry]
Version=1.0
Type=Application
Name=Notification History
Comment=Browse closed Dunst notifications
TryExec=ghostty
Exec=ghostty --window-decoration=client --gtk-titlebar=true -e /bin/sh -c "exec ~/.local/bin/notifications-history"
Terminal=false
Icon=preferences-system-notifications
Categories=Utility;
StartupNotify=true

# Sway configuration

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term ghostty
set $rofi_cmd rofi \
    -terminal '$term'
set $menu $rofi_cmd -show drun -modes drun
# Disable drag lock so double-click dragging ends when the button is released.
input type:touchpad {
    drag_lock enabled
}

### Outputs
output * bg ~/.wallpaper/wallpaper.png fill

### Input
input type:keyboard {
    repeat_delay 250
    repeat_rate 30
    xkb_layout us_fi
}

input type:touchpad {
    tap enabled
    dwt enabled
    natural_scroll enabled
    middle_emulation enabled
}

### Appearance
default_border pixel 2
default_floating_border pixel 2

client.focused          #4f5f86 #1e1e2e #cdd6f4 #4f5f86 #4f5f86
client.focused_inactive #313244 #1e1e2e #bac2de #313244 #313244
client.unfocused        #181825 #11111b #6c7086 #181825 #181825
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8 #f38ba8
client.placeholder      #181825 #11111b #6c7086 #181825 #181825

gaps inner 6
gaps outer 1
smart_gaps on

### Startup
exec swayidle -w \
    timeout 300 '(pgrep -x swaylock >/dev/null || ~/.local/bin/chayang) && swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 360 'swaylock -f' \
    before-sleep 'swaylock -f'

exec --no-startup-id unset GTK_IM_MODULE && fcitx5 -dr
exec --no-startup-id fcitx5-remote -s fi_us

### Applications
bindsym $mod+Return exec $term
bindsym $mod+Space exec $menu
bindsym $mod+e exec env GTK_THEME=Adwaita:dark thunar
bindsym $mod+Shift+s exec flatpak run org.flameshot.Flameshot gui
bindsym $mod+n exec ghostty -e ~/.local/bin/notifications-history
#bindsym $mod+b exec flatpak run org.mozilla.firefox
#exec /usr/libexec/lxqt-policykit-agent

### Session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
bindsym $mod+Ctrl+l exec swaylock
bindsym $mod+Escape exec loginctl lock-session && systemctl suspend

### Window Management
workspace_layout tabbed
floating_modifier $mod normal
bindsym $mod+q kill

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Tab focus right
bindsym $mod+Shift+Tab focus left
bindsym Mod1+Tab focus right
bindsym Mod1+Shift+Tab focus left

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+period resize grow width 30px, resize grow height 30px
bindsym $mod+comma resize shrink width 30px, resize shrink height 30px
bindsym $mod+Shift+period resize grow height 30px
bindsym $mod+Shift+comma resize shrink height 30px

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+d layout toggle split
bindsym $mod+z fullscreen
bindsym $mod+Shift+space floating toggle, resize set width 70 ppt height 70 ppt, move position center
bindsym $mod+t focus mode_toggle
bindsym $mod+a focus parent
bindsym f12 scratchpad show, resize set 100ppt 100ppt, move position center
bindsym $mod+f12 move scratchpad
bindsym $mod+c scratchpad show, resize set 100ppt 100ppt, move position center
bindsym Mod1+c exec ~/.config/sway/sway-toggle-terminal
bindsym $mod+Mod1+c move scratchpad

### Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace ">"

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace ">"

### Resize Mode
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Window Rules
for_window [floating] resize set width 70 ppt height 70 ppt, move position center
for_window [title=".*Ground Gives Way.*"] floating enable
for_window [title=".*Dungeon Crawl Stone Soup.*"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [app_id=".*pavucontrol"] floating enable
for_window [app_id=".*pavucontrol-qt"] floating enable

# Inlined from /usr/share/sway/config.d/50-rules-browser.conf
for_window [class="Chromium-browser"] mark Browser
for_window [class="Brave-browser"] mark Browser
for_window [class="firefox"] mark Browser
for_window [app_id="Chromium-browser"] mark Browser
for_window [app_id="brave-browser"] mark Browser
for_window [app_id="firefox"] mark Browser
for_window [con_mark="Browser"] inhibit_idle fullscreen
for_window [app_id="firefox" title="Firefox — Sharing Indicator"] floating enable

# Inlined from /usr/share/sway/config.d/50-rules-policykit-agent.conf
for_window [app_id="lxqt-policykit-agent"] {
    floating enable
    move position center
    resize set width 20 ppt height 20 ppt
}

# Inlined from /usr/share/sway/config.d/60-bindings-brightness.conf
set $brightness_notification_cmd command -v notify-send >/dev/null && \
    VALUE=$(brightnessctl --class=backlight --machine-readable | cut -d, -f4 | tr -d '%') && \
    notify-send -e -h string:x-canonical-private-synchronous:brightness \
        -h "int:value:$VALUE" -t 800 "Brightness: ${VALUE}%"
bindsym XF86MonBrightnessDown exec \
    'STEP="$brightness_step" && brightnessctl -q set ${STEP:-5}%- && $brightness_notification_cmd'
bindsym XF86MonBrightnessUp exec \
    'STEP="$brightness_step" && brightnessctl -q set +${STEP:-5}% && $brightness_notification_cmd'

# Inlined from /usr/share/sway/config.d/60-bindings-media.conf
bindsym --locked {
    XF86AudioPlay exec playerctl play-pause
    XF86AudioStop exec playerctl stop
}
bindsym {
    XF86AudioForward exec playerctl position +10
    XF86AudioNext exec playerctl next
    XF86AudioPause exec playerctl pause
    XF86AudioPrev exec playerctl previous
    XF86AudioRewind exec playerctl position -10
}

set $volume_sound_cmd paplay ~/.config/waybar/audio-volume-change.oga
bindsym --locked {
    XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle, exec $volume_sound_cmd
    XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%, exec $volume_sound_cmd
    XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%, exec $volume_sound_cmd
    XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
}

# Inlined from /usr/share/sway/config.d/90-bar.conf
bar {
    swaybar_command waybar
}

### Private Overrides
include ~/.config/sway/sway-local
